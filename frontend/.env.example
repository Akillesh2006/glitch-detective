# Frontend Environment Variables
# Local Development: defaults to http://localhost:8000 automatically (or Vite proxy)
# VITE_API_BASE_URL=http://localhost:8000
#
# Public Vercel Deployment:
# - Unified Vercel (frontend + serverless function): Leave unset or blank (uses same-origin relative /api)
# - Separate Backend (e.g., Render/Railway/Fly.io): Set to your deployed backend origin:
# VITE_API_BASE_URL=https://glitch-detective-api.example.com

