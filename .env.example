# ==============================================================================
# Glitch Detective - Environment Configuration Placeholders
# Copy this file to .env and adjust variables as needed for local development.
# NOTE: Do NOT commit secrets or actual credentials to version control.
# ==============================================================================

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Configuration
# - Local dev: http://localhost:8000
# - Unified Vercel deployment: leave blank/unset (routes to same-origin relative /api)
# - Separate backend deployment: set to full backend URL (e.g. https://glitch-detective-api.example.com)
VITE_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (comma-separated list for backend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# CORS Origin Regex (matches all Vercel production and preview domains)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
